  <script is:inline define:vars={{ specs: mallFacts.openingHours, labels: hoursUi }}>
  (() => {
    const pill = document.querySelector('[data-hours-pill]');
    const status = document.querySelector('[data-hours-status]');
    const detail = document.querySelector('[data-hours-detail]');
    if (!pill || !status || !detail) return;
    const toMinutes = (t) => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };
    const to12h = (t) => { const [h, m] = t.split(':').map(Number); return ((h + 11) % 12) + 1 + ':' + String(m).padStart(2, '0') + ' ' + (h < 12 ? 'AM' : 'PM'); };
    let hour = 0, minute = 0, weekday = '';
    try {
      const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Manila', weekday: 'long', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
      const part = (type) => (parts.find((p) => p.type === type) || {}).value;
      hour = Number(part('hour')); minute = Number(part('minute')); weekday = part('weekday') || '';
    } catch { return; }
    if (hour === 24) hour = 0;
    const today = specs.find((s) => s.days.indexOf(weekday) !== -1);
    if (!today) return;
    const nowMinutes = hour * 60 + minute;
    const isOpen = nowMinutes >= toMinutes(today.opens) && nowMinutes < toMinutes(today.closes);
    status.textContent = isOpen ? labels.openNow : labels.closedNow;
    detail.textContent = isOpen ? labels.closesAt + ' ' + to12h(today.closes) : labels.todayHours + ' ' + to12h(today.opens) + '–' + to12h(today.closes);
    pill.dataset.state = isOpen ? 'open' : 'closed';
  })();
  </script>

  <script is:inline>
  if ('serviceWorker' in navigator && location.protocol === 'https:') {
    window.addEventListener('load', () => { navigator.serviceWorker.register('/sw.js').catch(() => {}); });
  }
  </script>

  <script is:inline>
  (() => {
    const KEY = 'guide-consent-v1';
    const GA_ID = 'G-HXM22WWPKP';
    const banner = document.getElementById('cookie-banner');
    let gaLoaded = false;

    // GA4 Consent Mode v2. Everything is denied by default so no analytics or
    // advertising storage is written before the visitor actively opts in.
    window.dataLayer = window.dataLayer || [];
    window.gtag = function(){ window.dataLayer.push(arguments); };
    window.gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'granted',
      security_storage: 'granted',
      wait_for_update: 500
    });

    const read = () => { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; } };
    const syncConsent = (state) => {
      window.gtag('consent', 'update', {
        analytics_storage: state?.analytics ? 'granted' : 'denied',
        ad_storage: state?.marketing ? 'granted' : 'denied',
        ad_user_data: state?.marketing ? 'granted' : 'denied',
        ad_personalization: state?.marketing ? 'granted' : 'denied'
      });
    };
    const loadGA = () => {
      if (gaLoaded) return; gaLoaded = true;
      window.gtag('js', new Date());
      window.gtag('config', GA_ID, { anonymize_ip: true });
      const s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID; document.head.appendChild(s);
    };
    const apply = (state) => {
      syncConsent(state);
      if (state?.analytics) loadGA();
      if (banner) banner.hidden = !!state;
    };
    const save = (state) => { localStorage.setItem(KEY, JSON.stringify(state)); apply(state); };
    apply(read());
    document.getElementById('banner-necessary')?.addEventListener('click', () => save({ analytics:false, preferences:false, marketing:false }));
    document.getElementById('banner-analytics')?.addEventListener('click', () => save({ analytics:true, preferences:false, marketing:false }));
  })();
  </script>
