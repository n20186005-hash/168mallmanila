---
import '../styles/global.css';
import SourcesSection from './SourcesSection.astro';
import { content, localePaths, mallFacts, type Locale, type InfoCard, type Nearby, type Faq } from '../data/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = content[locale];
const site = Astro.site;
const currentPath = localePaths[locale];
const canonical = site ? new URL(currentPath, site).href : undefined;
const heroImage = site ? new URL('/images/168-street.jpg', site).href : undefined;
const routeHref = (path: string) => site ? new URL(path, site).href : path;
const embedBase = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6671.101191519387!2d120.97213470000001!3d14.605140500000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3397ca0ec391ad93%3A0x510fd5abc4fc32b8!2s168%20Shopping%20Mall!5e1!3m2!1s__LANG__!2s__REGION__!4v1786935432354!5m2!1s__LANG__!2s__REGION__';
const mapSrc = embedBase.replaceAll('__LANG__', c.mapLang).replaceAll('__REGION__', 'ph') + `&hl=${c.mapLang}&gl=ph`;

const origin = site ? site.origin : undefined;

// Single geographic entity node. `@id` lets Google anchor the Knowledge Graph node
// to this attraction, `alternateName` binds "168 Mall" / "168 Mall Divisoria" /
// "Manila 168 Shopping Mall" to the same entity, and `aggregateRating` carries a
// real reviewCount (from the Google Maps listing) — the same rating is also
// rendered visibly in the About block, which Google requires for review snippets.
const entityImages = site
  ? ['/images/168-street.jpg', '/images/168-interior.jpg', '/images/168-stalls.jpg'].map((p) => new URL(p, site).href)
  : undefined;

const placeJsonLd: any = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'ShoppingCenter', 'LocalBusiness'],
  name: mallFacts.name,
  alternateName: mallFacts.alternateNames,
  description: c.description,
  address: {
    '@type': 'PostalAddress', streetAddress: mallFacts.street, addressLocality: mallFacts.city, addressRegion: mallFacts.region, postalCode: mallFacts.postalCode, addressCountry: mallFacts.country
  },
  geo: { '@type': 'GeoCoordinates', latitude: mallFacts.latitude, longitude: mallFacts.longitude },
  containedInPlace: { '@type': 'City', name: mallFacts.city, url: 'https://manila.gov.ph/' },
  telephone: mallFacts.telephone,
  openingHoursSpecification: mallFacts.openingHours.map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.days, opens: h.opens, closes: h.closes })),
  isAccessibleForFree: true,
  hasMap: mallFacts.mapUrl,
  sameAs: [mallFacts.mapUrl, mallFacts.officialSite],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: mallFacts.ratingValue,
    reviewCount: mallFacts.ratingCount,
    bestRating: 5,
    worstRating: 1,
  },
};
if (canonical) placeJsonLd.url = canonical;
if (heroImage) placeJsonLd.image = heroImage;
if (entityImages) placeJsonLd.photo = entityImages.map((url) => ({ '@type': 'ImageObject', url }));
if (origin) placeJsonLd['@id'] = `${origin}/#attraction`;

// Geographic entity hierarchy: 168 Shopping Mall -> Binondo -> Manila -> Metro Manila
// -> Philippines. Mirrored by the visible breadcrumb at the top of <main>.
const breadcrumbEntries = [
  { name: mallFacts.name, item: canonical },
  { name: mallFacts.adminHierarchy[0], item: mallFacts.mapSearchUrl },
  { name: mallFacts.adminHierarchy[1], item: 'https://manila.gov.ph/' },
  { name: mallFacts.adminHierarchy[2], item: undefined },
  { name: mallFacts.adminHierarchy[3], item: undefined },
].filter((entry) => entry.item !== undefined);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbEntries.map((entry, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: entry.name,
    ...(entry.item ? { item: entry.item } : {}),
  })),
};

const websiteJsonLd: any = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '168 Shopping Mall Visitor Guide',
  inLanguage: ['fil-PH', 'en-PH', 'zh-CN'],
};
if (origin) { websiteJsonLd.url = origin; websiteJsonLd['@id'] = `${origin}/#website`; }

const ui = {
  fil: { map: 'MAPA', checked: 'SINURI, PERO MAAARING MAGBAGO', logoAlt: 'Gabay sa 168 Shopping Mall', navLabel: 'Pangunahing nabigasyon', langLabel: 'Pumili ng wika', quickLabel: 'Mabilisang impormasyon', badgeLocation: 'Soler Street · Maynila', streetAlt: '168 Shopping Mall — pangunahing tanaw sa Soler Street, Divisoria, Maynila, Pilipinas', interiorAlt: 'Mataong shopping aisle sa loob ng 168 Shopping Mall', stallsAlt: 'Mga retail stall at mamimili sa loob ng 168 Shopping Mall', mapTitle: 'Google Map — 168 Shopping Mall, Maynila' },
  en: { map: 'MAP', checked: 'CHECKED, BUT SUBJECT TO CHANGE', logoAlt: '168 Shopping Mall Visitor Guide', navLabel: 'Primary navigation', langLabel: 'Language switcher', quickLabel: 'Quick facts', badgeLocation: 'Soler Street · Manila', streetAlt: '168 Shopping Mall — main view on Soler Street, Divisoria, Manila, Philippines', interiorAlt: 'Busy shopping aisle inside 168 Shopping Mall', stallsAlt: 'Retail stalls and shoppers inside 168 Shopping Mall', mapTitle: 'Google Map — 168 Shopping Mall, Manila' },
  zh: { map: '地图', checked: '已核对，但信息可能变化', logoAlt: '168 Shopping Mall 游客指南', navLabel: '主导航', langLabel: '语言切换', quickLabel: '快速信息', badgeLocation: 'Soler Street · 马尼拉', streetAlt: '168 Shopping Mall — 菲律宾马尼拉 Divisoria Soler Street 主视图', interiorAlt: '168 Shopping Mall 内繁忙的购物通道', stallsAlt: '168 Shopping Mall 内的零售摊位与购物者', mapTitle: 'Google 地图 — 马尼拉 168 Shopping Mall' }
}[locale];

// Labels for the entity-binding blocks added below (breadcrumb, about, location,
// landmarks, history). Kept separate from `ui` so the existing copy stays untouched.
const entityUi = {
  fil: { breadcrumbLabel: 'Nasa', aboutLabel: 'Ang destinasyon', locationLabel: 'LOKASYON AT PAGPUNTA', addressLabel: 'Address', plusCodeLabel: 'Plus Code', coordsLabel: 'Koordinado', phoneLabel: 'Telepono', landmarksLabel: 'MGA KALAPIT NA PUNTAHAN', historyLabel: 'KASAYSAYAN' },
  en: { breadcrumbLabel: 'Breadcrumb', aboutLabel: 'The destination', locationLabel: 'LOCATION & HOW TO VISIT', addressLabel: 'Address', plusCodeLabel: 'Plus Code', coordsLabel: 'Coordinates', phoneLabel: 'Phone', landmarksLabel: 'NEARBY HIGHLIGHTS', historyLabel: 'HISTORY & SIGNIFICANCE' },
  zh: { breadcrumbLabel: '当前位置', aboutLabel: '实体信息', locationLabel: '位置与到访', addressLabel: '地址', plusCodeLabel: 'Plus Code', coordsLabel: '坐标', phoneLabel: '电话', landmarksLabel: '周边亮点', historyLabel: '历史与意义' },
}[locale];

const faqJsonLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: c.faqs.map((f: any) => ({ '@type':'Question', name:f.q, acceptedAnswer:{ '@type':'Answer', text:f.a } }))
};

// Labels for the client-side "open now / closed now" indicator. Computed in the
// browser against Asia/Manila so a statically built page never claims stale hours.
const hoursUi = {
  fil: { hoursLabel: 'Oras ngayon', openNow: 'Bukas ngayon', closedNow: 'Sarado ngayon', closesAt: 'hanggang', todayHours: 'Ngayong araw', call: 'Tumawag' },
  en: { hoursLabel: "Today's hours", openNow: 'Open now', closedNow: 'Closed now', closesAt: 'closes', todayHours: 'Today', call: 'Call mall' },
  zh: { hoursLabel: '今日营业', openNow: '现在营业', closedNow: '现在休息', closesAt: '至', todayHours: '今日', call: '打电话' },
}[locale];
---
<!doctype html>
<html lang={c.lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="theme-color" content="#f6f0e4" />
  <title>{c.title}</title>
  <meta name="description" content={c.description} />
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="alternate" hreflang="fil-PH" href={routeHref('/')} />
  <link rel="alternate" hreflang="en-PH" href={routeHref('/en/')} />
  <link rel="alternate" hreflang="zh-CN" href={routeHref('/zh/')} />
  <link rel="alternate" hreflang="x-default" href={routeHref('/')} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="168 Shopping Mall Visitor Guide" />
  <meta property="og:title" content={c.title} />
  <meta property="og:description" content={c.description} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={heroImage ?? '/images/168-street.jpg'} />
  <meta property="og:image:alt" content={c.title} />
  <meta property="og:locale" content={c.lang.replace('-', '_')} />
  {(['fil','en','zh'] as Locale[]).filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={content[l].lang.replace('-', '_')} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={c.title} />
  <meta name="twitter:description" content={c.description} />
  <meta name="twitter:image" content={heroImage ?? '/images/168-street.jpg'} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="application-name" content="168 Mall Guide" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="168 Mall Guide" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta property="og:image:width" content="1800" />
  <meta property="og:image:height" content="1350" />
  <meta property="og:image:type" content="image/jpeg" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(placeJsonLd)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)}></script>
</head>
<body>
  <header class="sticky top-0 z-40 border-b border-black/15 bg-[#f6f0e4]/95 backdrop-blur">
    <div class="shell flex min-h-16 items-center justify-between gap-4">
      <a href={localePaths[locale]} aria-label={ui.logoAlt} class="flex items-center gap-3 no-underline">
        <img src="/logo.svg" width="136" height="38" alt={ui.logoAlt} />
      </a>
      <nav class="hidden items-center gap-5 text-sm font-bold lg:flex" aria-label={ui.navLabel}>
        <a href="#guide">{c.nav[0]}</a><a href="#transport">{c.nav[1]}</a><a href="#food">{c.nav[2]}</a><a href="#nearby">{c.nav[3]}</a><a href="#faq">{c.nav[4]}</a>
      </nav>
      <div class="flex items-center gap-1 text-xs font-extrabold" aria-label={ui.langLabel}>
        {(['fil','en','zh'] as Locale[]).map((l) => <a href={localePaths[l]} hreflang={content[l].lang} class:list={['border px-2 py-1.5 no-underline', l === locale ? 'border-black bg-black text-white' : 'border-black/20 bg-white/50']}>{content[l].short}</a>)}
      </div>
    </div>
  </header>

  <main>
    <nav class="breadcrumb" aria-label={entityUi.breadcrumbLabel}>
      <div class="shell">
        <ol>
          <li><a href={localePaths[locale]}>{mallFacts.name}</a></li>
          {mallFacts.adminHierarchy.map((step: string, i: number) => (
            <li aria-current={i === mallFacts.adminHierarchy.length - 1 ? 'true' : undefined}>{step}</li>
          ))}
        </ol>
      </div>
    </nav>

    <section class="hero-grid" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="kicker text-[#174c9c]">{c.eyebrow}</p>
        <h1 id="hero-title" class="mt-5">
          <span class="hero-entity">{mallFacts.name} <span class="hero-entity-place">({mallFacts.locality}, {mallFacts.countryName})</span></span>
          <span class="display mt-3 block whitespace-pre-line text-[clamp(3.8rem,7.5vw,7.8rem)]">{c.heroTitle}</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg text-[#4e4942]">{c.heroBody}</p>
        <p class="hours-pill mt-6" data-hours-pill>
          <span class="dot" aria-hidden="true"></span>
          <strong data-hours-status>{hoursUi.hoursLabel}</strong>
          <span data-hours-detail>{c.hoursShort}</span>
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn blue" href="#guide">{c.heroCta}</a>
          <a class="btn secondary" href={mallFacts.mapUrl} target="_blank" rel="noopener noreferrer">{c.mapCta} ↗</a>
        </div>
      </div>
      <div class="hero-photo">
        <img src="/images/168-street.jpg" alt={ui.streetAlt} width="1800" height="1350" fetchpriority="high" />
        <div class="hero-badge">168 × DIVISORIA<br/><span class="text-sm font-medium">{ui.badgeLocation}</span></div>
      </div>
    </section>

    <section class="shell py-7" aria-label={ui.quickLabel}>
      <div class="quick-grid">
        {c.quick.map((item: string[]) => <div class="quick-cell"><div class="kicker text-[#d92d2d]">{item[0]}</div><div class="mt-2 whitespace-pre-line font-bold leading-snug">{item[1]}</div></div>)}
      </div>
    </section>

    <section id="about" class="shell scroll-mt-24 py-16">
      <div class="grid gap-8 lg:grid-cols-[.82fr_1.18fr] lg:items-start">
        <div>
          <p class="kicker text-[#174c9c]">{entityUi.aboutLabel}</p>
          <h2 class="section-title mt-4">{c.aboutTitle}</h2>
        </div>
        <div>
          <p class="text-lg text-[#514c45]">{c.entityLead}</p>
          <p class="mt-5 max-w-2xl text-[#514c45]">{c.aboutBody}</p>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <span class="rating-chip">
              <strong>{mallFacts.ratingValue}</strong> / 5
              <span>{mallFacts.ratingCount.toLocaleString('en-US')} {c.reviewsLabel}</span>
            </span>
            <a class="text-sm font-extrabold text-[#174c9c]" href={mallFacts.mapUrl} target="_blank" rel="noopener noreferrer">{mallFacts.ratingSource} ↗</a>
          </div>
          <dl class="entity-facts mt-8">
            <div><dt>{entityUi.addressLabel}</dt><dd>{mallFacts.street}, {mallFacts.locality} {mallFacts.postalCode}, {mallFacts.region}, {mallFacts.countryName}</dd></div>
            <div><dt>{entityUi.plusCodeLabel}</dt><dd>{mallFacts.plusCode}</dd></div>
            <div><dt>{entityUi.coordsLabel}</dt><dd>{mallFacts.latitude}, {mallFacts.longitude}</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section id="guide" class="shell scroll-mt-24 py-20">
      <div class="grid gap-10 lg:grid-cols-[.82fr_1.18fr] lg:items-end">
        <div>
          <p class="kicker text-[#d92d2d]">{c.sectionIntro}</p>
          <h2 class="section-title mt-4">{c.introTitle}</h2>
        </div>
        <p class="max-w-2xl text-lg text-[#514c45]">{c.introBody}</p>
      </div>
      <div class="photo-collage mt-12">
        <img src="/images/168-interior.jpg" alt={ui.interiorAlt} width="1024" height="683" loading="lazy" />
        <div class="photo-stack">
          <img src="/images/168-stalls.jpg" alt={ui.stallsAlt} width="1350" height="1800" loading="lazy" />
          <div class="paper-card p-6 sm:p-8">
            <div class="text-7xl font-black tracking-[-.08em] text-[#174c9c]">1,500+</div>
            <p class="mt-2 max-w-sm text-[#514c45]">{locale === 'fil' ? 'mga tindahan ayon sa opisyal na impormasyon ng mall' : locale === 'zh' ? '家以上店铺（据商场官方资料）' : 'stores according to official mall information'}</p>
            <div class="mt-8 text-6xl font-black tracking-[-.08em] text-[#d92d2d]">7</div>
            <p class="mt-2 text-[#514c45]">{locale === 'fil' ? 'antas ng pamimili' : locale === 'zh' ? '层购物空间' : 'levels of shopping'}</p>
          </div>
        </div>
      </div>
      <div class="card-grid mt-12">
        {c.shopCards.map((x: InfoCard) => <article class="info-card"><h3>{x.title}</h3><p>{x.body}</p></article>)}
      </div>
    </section>

    <section id="plan" class="border-y border-black/15 bg-[#fffaf0] py-20 scroll-mt-24">
      <div class="shell">
        <p class="kicker text-[#174c9c]">{c.planLabel}</p>
        <h2 class="section-title mt-4 max-w-4xl">{c.planTitle}</h2>
        <div class="card-grid mt-10">
          {c.infoCards.map((x: InfoCard) => <article class="info-card"><h3>{x.title}</h3><p>{x.body}</p>{x.note && <p class="note">{x.note}</p>}</article>)}
        </div>
      </div>
    </section>

    <section id="location" class="shell scroll-mt-24 py-20">
      <div class="grid gap-10 lg:grid-cols-[.82fr_1.18fr] lg:items-start">
        <div>
          <p class="kicker text-[#174c9c]">{entityUi.locationLabel}</p>
          <h2 class="section-title mt-4">{c.locationTitle}</h2>
        </div>
        <div>
          <p class="text-lg text-[#514c45]">{c.locationBody}</p>
          <dl class="entity-facts mt-8">
            <div><dt>{entityUi.addressLabel}</dt><dd>{mallFacts.street}, {mallFacts.locality} {mallFacts.postalCode}, {mallFacts.region}, {mallFacts.countryName}</dd></div>
            <div><dt>{entityUi.plusCodeLabel}</dt><dd>{mallFacts.plusCode}</dd></div>
            <div><dt>{entityUi.coordsLabel}</dt><dd>{mallFacts.latitude}, {mallFacts.longitude}</dd></div>
            <div><dt>{entityUi.phoneLabel}</dt><dd><a href={mallFacts.telephoneHref}>{mallFacts.telephone}</a></dd></div>
          </dl>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn blue" href={mallFacts.mapUrl} target="_blank" rel="noopener noreferrer">{c.mapCta} ↗</a>
            <a class="btn secondary" href="#transport">{c.nav[1]}</a>
          </div>
        </div>
      </div>
    </section>

    <section id="transport" class="shell scroll-mt-24 pb-20">
      <p class="kicker text-[#d92d2d]">{c.transportLabel}</p>
      <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_.7fr] lg:items-end"><h2 class="section-title">{c.transportTitle}</h2><p class="text-[#514c45]">{c.transportLead}</p></div>
      <div class="route-grid mt-10">{c.transport.map((x: InfoCard, i: number) => <article class="route-card" data-index={`0${i+1}`}><h3 class="text-lg font-extrabold">{x.title}</h3><p class="mt-3 text-sm text-[#514c45]">{x.body}</p></article>)}</div>
      <div class="mt-12 grid gap-6 lg:grid-cols-[.36fr_.64fr] lg:items-stretch">
        <div class="paper-card p-7"><p class="kicker text-[#174c9c]">{ui.map}</p><h3 class="mt-4 font-serif text-4xl leading-none">{c.mapTitle}</h3><p class="mt-5 text-[#514c45]">{c.mapBody}</p><a class="btn mt-7" href={mallFacts.mapUrl} target="_blank" rel="noopener noreferrer">{c.mapCta} ↗</a></div>
        <div class="map-wrap"><iframe src={mapSrc} title={ui.mapTitle} width="600" height="450" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
      </div>
    </section>

    <section id="food" class="scroll-mt-24 border-y border-black/15 bg-[#174c9c] py-20 text-white">
      <div class="shell">
        <p class="kicker text-white/70">{c.foodLabel}</p><h2 class="section-title mt-4 max-w-4xl">{c.foodTitle}</h2><p class="mt-6 max-w-2xl text-white/75">{c.foodIntro}</p>
        <div class="nearby-grid mt-10">{c.foods.map((x: Nearby) => <article class="nearby-card !border-white/25 !bg-white/10"><div><h3>{x.name}</h3><p class="!text-white/70">{x.detail}</p></div><span class="market-tag h-fit shrink-0">{x.tag}</span></article>)}</div>
      </div>
    </section>

    <section id="landmarks" class="shell scroll-mt-24 py-20">
      <p class="kicker text-[#174c9c]">{entityUi.landmarksLabel}</p>
      <h2 class="section-title mt-4 max-w-4xl">{c.landmarksTitle}</h2>
      <p class="mt-6 max-w-3xl text-lg text-[#514c45]">{c.landmarksBody}</p>

      <div id="nearby" class="rule mt-16 scroll-mt-24 pt-16">
        <p class="kicker text-[#d92d2d]">{c.nearbyLabel}</p><h2 class="section-title mt-4 max-w-4xl">{c.nearbyTitle}</h2>
        <div class="nearby-grid mt-10">{c.nearby.map((x: Nearby) => <article class="nearby-card"><div><h3>{x.name}</h3><p>{x.detail}</p></div><span class="market-tag h-fit shrink-0 text-[#174c9c]">{x.tag}</span></article>)}</div>
      </div>
    </section>

    <section id="history" class="shell scroll-mt-24 py-20">
      <div class="rule grid gap-10 pt-16 lg:grid-cols-[.35fr_.65fr]">
        <div><p class="kicker text-[#174c9c]">{entityUi.historyLabel}</p><h2 class="section-title mt-4">{c.historyTitle}</h2></div>
        <p class="max-w-2xl text-lg text-[#514c45]">{c.historyBody}</p>
      </div>
    </section>

    <section id="faq" class="border-t border-black/15 bg-[#fffaf0] py-20 scroll-mt-24">
      <div class="shell grid gap-10 lg:grid-cols-[.35fr_.65fr]">
        <div><p class="kicker text-[#174c9c]">{c.faqLabel}</p><h2 class="section-title mt-4">{c.faqTitle}</h2></div>
        <div class="faq-list">{c.faqs.map((f: Faq) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
      </div>
    </section>

    <section class="shell py-16">
      <div class="paper-card grid gap-6 p-6 md:grid-cols-[1fr_auto] md:items-end md:p-8"><div><p class="kicker text-[#d92d2d]">{ui.checked}</p><h2 class="mt-3 font-serif text-3xl">{c.sourceTitle}</h2><p class="mt-3 max-w-4xl text-sm text-[#514c45]">{c.sourceBody}</p></div><a class="btn secondary whitespace-nowrap" href={mallFacts.officialSite} target="_blank" rel="noopener noreferrer">{c.official} ↗</a></div>
    </section>

    <SourcesSection locale={locale} />

    <section class="shell pb-20">
